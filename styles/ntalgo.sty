% badness-format skip
\newenvironment{algo}
{
  \begin{tabular}{|l|}
    \hline
    \begin{minipage}{1in}
      \begin{tabbing}
        \quad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\qquad\=\kill
          }{
